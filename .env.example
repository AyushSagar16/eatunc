# Public client-side environment variables.
# These values are exposed to the browser, so only use public keys here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Optional development flag used by the menu page debug UI.
NEXT_PUBLIC_DEBUG_MENU_PAGE=false
