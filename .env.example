# Public client-side environment variables.
# These values are exposed to the browser, so only use public keys here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Optional development flag used by the menu page debug UI.
NEXT_PUBLIC_DEBUG_MENU_PAGE=false

# Server-only. NOT browser-exposed, and must never be renamed to NEXT_PUBLIC_*.
# The bearer token POST /api/revalidate requires. eat-unc-backend's nightly sweep calls that
# route after it finishes writing, which is what rebuilds /locations, the venue pages and
# /brands — instead of a 5-to-15-minute timer guessing at when the data changed and paying an
# ISR write for every guess. Unset means the route answers 503 and the fallback revalidate
# windows take over; it never blocks a build or a deploy.
REVALIDATE_TOKEN=a-long-random-string
